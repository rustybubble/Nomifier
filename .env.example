# Copy to .env on System B only. Never commit .env.
BOT_TOKEN=
AISLE_FINDER_WEBHOOK_URL=
AISLE_FINDER_WEBHOOK_KEY=
COVERAGE_CLERK_WEBHOOK_URL=
COVERAGE_CLERK_WEBHOOK_KEY=
